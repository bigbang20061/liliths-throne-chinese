<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<dialogueNodes>

	<scene id="swallow_confirm">
		<title><![CDATA[吞噬]]></title>
		<tooltip><![CDATA[将眼前的人吞进你的胃里。]]></tooltip>
		<preParsingEffects><![CDATA[
			[#game.setParserTarget('prey', npc)]
		]]></preParsingEffects>
		<content folderPath="mods/unbirth/content">VORE_SWALLOW_CONFIRM</content>
		<secondsPassed minutes="true"><![CDATA[1]]></secondsPassed>
		<continuesDialogue><![CDATA[false]]></continuesDialogue>
		<travelDisabled><![CDATA[true]]></travelDisabled>
		<inventoryDisabled><![CDATA[true]]></inventoryDisabled>
		<responses>
			<response>
				<availabilityConditional><![CDATA[[#game.canBeSwallowed(prey, 'STOMACH')]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[确认吞噬]]></responseTitle>
				<responseTooltip><![CDATA[将[prey.name]整个人吞进你的胃里。]]></responseTooltip>
				<colour><![CDATA[GENERIC_SEX]]></colour>
				<nextDialogue><![CDATA[unbirth_scenes_carrying]]></nextDialogue>
				<secondsPassed minutes="true"><![CDATA[2]]></secondsPassed>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('mods/unbirth/content', 'VORE_SWALLOW_SUCCESS'))]
					[#game.addContainedCharacter(prey, 'STOMACH')]
				]]></effects>
			</response>
			<response>
				<availabilityConditional><![CDATA[[#!game.canBeSwallowed(prey, 'STOMACH')]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[确认吞噬]]></responseTitle>
				<responseTooltip><![CDATA[[#game.getSwallowBlockReason(pc, prey, 'STOMACH')]]]></responseTooltip>
				<nextDialogue><![CDATA[null]]></nextDialogue>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[0]]></index>
				<responseTitle><![CDATA[取消]]></responseTitle>
				<responseTooltip><![CDATA[还是先不把[prey.name]吞进去了。]]></responseTooltip>
				<nextDialogue><![CDATA[HC_encounter_alleyway_victory]]></nextDialogue>
			</response>
		</responses>
	</scene>

	<scene id="digest">
		<title><![CDATA[消化]]></title>
		<tooltip><![CDATA[消化胃中的猎物。]]></tooltip>
		<preParsingEffects><![CDATA[
		]]></preParsingEffects>
		<content folderPath="mods/unbirth/content">VORE_DIGEST</content>
		<secondsPassed minutes="true"><![CDATA[5]]></secondsPassed>
		<continuesDialogue><![CDATA[false]]></continuesDialogue>
		<travelDisabled><![CDATA[true]]></travelDisabled>
		<inventoryDisabled><![CDATA[true]]></inventoryDisabled>
		<responses>
			<response>
				<availabilityConditional><![CDATA[[#game.getContainedCharacterCount(pc)>0]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[体内]]></responseTitle>
				<responseTooltip><![CDATA[你的体内还有其他人。]]></responseTooltip>
				<nextDialogue><![CDATA[unbirth_scenes_carrying]]></nextDialogue>
			</response>
			<response>
				<availabilityConditional><![CDATA[[#game.getContainedCharacterCount(pc)<=0]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[继续]]></responseTitle>
				<responseTooltip><![CDATA[胃已经空了。]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[0]]></index>
				<responseTitle><![CDATA[离开]]></responseTitle>
				<responseTooltip><![CDATA[离开这里，继续你的旅程。]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
			</response>
		</responses>
	</scene>

</dialogueNodes>
