<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<dialogueNodes>

	<!-- 吞入确认：展示猎物信息，确认后调用 addContainedCharacter。 -->
	<scene id="swallow_confirm">
		<title><![CDATA[吞入]]></title>
		<tooltip><![CDATA[把眼前的人从穴里整个人吞进子宫。]]></tooltip>
		<preParsingEffects><![CDATA[
			[#game.setParserTarget('prey', npc)]
		]]></preParsingEffects>
		<content folderPath="mods/unbirth/content">SWALLOW_CONFIRM</content>
		<secondsPassed minutes="true"><![CDATA[1]]></secondsPassed>
		<continuesDialogue><![CDATA[false]]></continuesDialogue>
		<travelDisabled><![CDATA[true]]></travelDisabled>
		<inventoryDisabled><![CDATA[true]]></inventoryDisabled>
		<responses>
			<response>
				<availabilityConditional><![CDATA[[#game.canBeSwallowed(prey)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[确认吞入]]></responseTitle>
				<responseTooltip><![CDATA[把[prey.name]的头按进湿穴，整个人吞进子宫。]]></responseTooltip>
				<colour><![CDATA[GENERIC_SEX]]></colour>
				<nextDialogue><![CDATA[unbirth_scenes_carrying]]></nextDialogue>
				<secondsPassed minutes="true"><![CDATA[2]]></secondsPassed>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('mods/unbirth/content', 'SWALLOW_SUCCESS'))]
					[#game.addContainedCharacter(prey, 'WOMB')]
				]]></effects>
			</response>
			<response>
				<availabilityConditional><![CDATA[[#!game.canBeSwallowed(prey)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[确认吞入]]></responseTitle>
				<responseTooltip><![CDATA[[#game.getSwallowBlockReason(prey)]]]></responseTooltip>
				<nextDialogue><![CDATA[null]]></nextDialogue>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[0]]></index>
				<responseTitle><![CDATA[取消]]></responseTitle>
				<responseTooltip><![CDATA[先忍住，不把[prey.name]吞进体内。]]></responseTooltip>
				<nextDialogue><![CDATA[HC_encounter_alleyway_victory]]></nextDialogue>
			</response>
		</responses>
	</scene>

